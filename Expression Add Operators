Given a string num that contains only digits and an integer target, return all possibilities to insert the binary operators '+', '-', and/or '*' between the digits of num so that the resultant expression evaluates to the target value.
Note that operands in the returned expressions should not contain leading zeros.
Note that a number can contain multiple digits.

import java.util.ArrayList;
import java.util.List;

public class Solution {
    public List<String> addOperators(String num, int target) {
        List<String> result = new ArrayList<>();
        if (num == null || num.length() == 0) {
            return result;
        }
        // Use StringBuilder for optimal string manipulation performance
        backtrack(result, new StringBuilder(), num, target, 0, 0, 0);
        return result;
    }

    private void backtrack(List<String> result, StringBuilder path, String num, int target, 
                           int index, long currentTotal, long previousTerm) {
        
        // Base case: if we have processed all digits
        if (index == num.length()) {
            if (currentTotal == target) {
                result.add(path.toString());
            }
            return;
        }

        for (int j = index; j < num.length(); j++) {
            // Prevent leading zeros for multi-digit numbers
            if (j > index && num.charAt(index) == '0') {
                break;
            }

            // Extract the current operand string and parse its long value to prevent overflow
            String operandStr = num.substring(index, j + 1);
            long operandVal = Long.parseLong(operandStr);
            int len = path.length();

            // If it's the first number, we don't place any operator before it
            if (index == 0) {
                path.append(operandStr);
                backtrack(result, path, num, target, j + 1, operandVal, operandVal);
                path.setLength(len); // Backtrack
            } else {
                // Try Addition
                path.append('+').append(operandStr);
                backtrack(result, path, num, target, j + 1, currentTotal + operandVal, operandVal);
                path.setLength(len); // Backtrack

                // Try Subtraction
                path.append('-').append(operandStr);
                backtrack(result, path, num, target, j + 1, currentTotal - operandVal, -operandVal);
                path.setLength(len); // Backtrack

                // Try Multiplication
                path.append('*').append(operandStr);
                backtrack(result, path, num, target, j + 1, 
                          (currentTotal - previousTerm) + (previousTerm * operandVal), previousTerm * operandVal);
                path.setLength(len); // Backtrack
            }
        }
    }

    public static void main(String[] args) {
        Solution solver = new Solution();
        
        // Example 1
        System.out.println(solver.addOperators("123", 6)); 
        // Output: [1+2+3, 1*2*3]

        // Example 2
        System.out.println(solver.addOperators("105", 5)); 
        // Output: [1*0+5, 10-5]
    }
}
