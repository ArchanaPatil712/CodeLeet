Given an integer array nums, reorder it such that nums[0] < nums[1] > nums[2] < nums[3]....
You may assume the input array always has a valid answer.

import java.util.Arrays;

class Solution {
    public void wiggleSort(int[] nums) {
        int n = nums.length;
        
        // 1. Create a sorted copy of the array
        int[] sorted = nums.clone();
        Arrays.sort(sorted);
        
        // 2. Point to the end of the smaller half and larger half
        int left = (n - 1) / 2;
        int right = n - 1;
        
        // 3. Fill the original array alternating between both halves
        for (int i = 0; i < n; i++) {
            if (i % 2 == 0) {
                nums[i] = sorted[left];
                left--;
            } else {
                nums[i] = sorted[right];
                right--;
            }
        }
    }
}
