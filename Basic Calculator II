Given a string s which represents an expression, evaluate this expression and return its value. 
The integer division should truncate toward zero.
You may assume that the given expression is always valid. All intermediate results will be in the range of [-231, 231 - 1].
Note: You are not allowed to use any built-in function which evaluates strings as mathematical expressions, such as eval().

import java.util.Stack;

class Solution {
    public int calculate(String s) {
        if (s == null || s.isEmpty()) {
            return 0;
        }

        Stack<Integer> stack = new Stack<>();
        int currentNumber = 0;
        char currentSign = '+';
        int len = s.length();

        for (int i = 0; i < len; i++) {
            char currentChar = s.charAt(i);

            // Parse multi-digit numbers
            if (Character.isDigit(currentChar)) {
                currentNumber = currentNumber * 10 + (currentChar - '0');
            }

            // Process the previous operator when finding a new one or reaching the end
            if ((!Character.isDigit(currentChar) && currentChar != ' ') || i == len - 1) {
                if (currentSign == '+') {
                    stack.push(currentNumber);
                } else if (currentSign == '-') {
                    stack.push(-currentNumber);
                } else if (currentSign == '*') {
                    stack.push(stack.pop() * currentNumber);
                } else if (currentSign == '/') {
                    stack.push(stack.pop() / currentNumber); // Java integer division truncates toward zero by default
                }
                
                // Update to the new sign and reset the current number
                currentSign = currentChar;
                currentNumber = 0;
            }
        }

        // Sum up all elements left in the stack
        int result = 0;
        while (!stack.isEmpty()) {
            result += stack.pop();
        }

        return result;
    }
}
