An ugly number is a positive integer whose prime factors are limited to 2, 3, and 5.
Given an integer n, return the nth ugly number.

class Solution {
    public int nthUglyNumber(int n) {
        // Array to store the sequence of ugly numbers
        int[] ugly = new int[n];
        ugly[0] = 1; // 1 is always the first ugly number
        
        // Pointers for the indices of the ugly array to be multiplied by 2, 3, and 5
        int i2 = 0, i3 = 0, i5 = 0;
        
        for (int i = 1; i < n; i++) {
            // Compute the next possible candidates
            int next2 = ugly[i2] * 2;
            int next3 = ugly[i3] * 3;
            int next5 = ugly[i5] * 5;
            
            // Choose the smallest candidate to keep the array sorted
            int nextUgly = Math.min(next2, Math.min(next3, next5));
            ugly[i] = nextUgly;
            
            // Move the pointer forward for whichever factor produced this minimum value
            if (nextUgly == next2) i2++;
            if (nextUgly == next3) i3++;
            if (nextUgly == next5) i5++;
        }
        
        // The last element is the n-th ugly number
        return ugly[n - 1];
    }
}


