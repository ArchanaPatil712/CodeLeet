Given a matrix mat[][] of size n × n, where mat[i][j] represents the maximum number of steps a rat can jump either forward (right) or downward from that cell, find a path for the rat to reach from the top-left cell (0, 0) to the bottom-right cell (n - 1, n - 1). A cell containing 0 is blocked and cannot be used in the path. It is guaranteed that the cell mat[n-1][n-1] is not 0.
Return an n × n matrix where 1 represents the cells included in the path and 0 represents the remaining cells. If no valid path exists, return [[-1]].
Note: If multiple valid paths exist, choose the path with the shortest possible jumps first. For the same jump length, moving forward (right) should be preferred over moving downward.

#include <vector>

using namespace std;

class Solution {
  private:
    int n;
    // visited[x][y] == -1 means this cell is a dead end (failed path)
    vector<vector<int>> visited;
    
    bool backtrack(int x, int y, vector<vector<int>>& mat, vector<vector<int>>& sol) {
        // Base Case: Destination reached
        if (x == n - 1 && y == n - 1) {
            sol[x][y] = 1;
            return true;
        }
        
        // Boundary check, blocked check, and memoization check
        if (x >= 0 && x < n && y >= 0 && y < n && mat[x][y] != 0 && visited[x][y] == 0) {
            // Include current cell in the solution path
            sol[x][y] = 1;
            
            int max_jumps = mat[x][y];
            
            // Loop through jump lengths from shortest (1) to longest (max_jumps)
            for (int jmp = 1; jmp <= max_jumps; ++jmp) {
                // 1. Move Forward / Right
                if (backtrack(x, y + jmp, mat, sol)) {
                    return true;
                }
                // 2. Move Downward
                if (backtrack(x + jmp, y, mat, sol)) {
                    return true;
                }
            }
            
            // Backtrack: Remove cell from path since no moves from here succeed
            sol[x][y] = 0;
            // Memoize: Mark this cell as a dead end so it is never re-calculated
            visited[x][y] = -1;
        }
        
        return false;
    }

  public:
    vector<vector<int>> shortestDist(vector<vector<int>>& mat) {
        n = mat.size();
        if (n == 0) return {{-1}};
        
        // Initialize solution matrix and visited memoization matrix
        vector<vector<int>> sol(n, vector<int>(n, 0));
        visited.assign(n, vector<int>(n, 0));
        
        if (backtrack(0, 0, mat, sol)) {
            return sol;
        }
        
        return {{-1}};
    }
};
