Given a singly linked list, remove all nodes that have a node with a greater value anywhere to their right in the list. Return the head of the modified linked list.

class Solution {
    Node compute(Node head) {
        // Base case: end of list
        if (head == null || head.next == null) {
            return head;
        }
        
        // Recursively solve for the rest of the list
        Node nextNode = compute(head.next);
        
        // If the next node has a greater value, discard the current node
        if (nextNode.data > head.data) {
            return nextNode;
        }
        
        // Otherwise, link the current node to the processed next node
        head.next = nextNode;
        return head;
    }
}
