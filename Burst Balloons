You are given n balloons, indexed from 0 to n - 1. Each balloon is painted with a number on it represented by an array nums. You are asked to burst all the balloons.
If you burst the ith balloon, you will get nums[i - 1] * nums[i] * nums[i + 1] coins. If i - 1 or i + 1 goes out of bounds of the array, then treat it as if there is a balloon with a 1 painted on it.
Return the maximum coins you can collect by bursting the balloons wisely.

class Solution {
    public int maxCoins(int[] nums) {
        int n = nums.length;
        
        // 1. Pad the boundaries with 1
        int[] A = new int[n + 2];
        A[0] = 1;
        A[n + 1] = 1;
        for (int i = 0; i < n; i++) {
            A[i + 1] = nums[i];
        }
        
        // 2. Initialize the DP table
        // dp[i][j] stores the max coins for bursting balloons strictly between i and j
        int[][] dp = new int[n + 2][n + 2];
        
        // 3. l is the length of the sub-array window
        for (int l = 1; l <= n; l++) {
            // i is the left boundary
            for (int i = 0; i <= n - l; i++) {
                int j = i + l + 1; // j is the right boundary
                
                // Find the best last balloon 'k' to burst in range (i, j)
                for (int k = i + 1; k < j; k++) {
                    int coins = A[i] * A[k] * A[j] + dp[i][k] + dp[k][j];
                    dp[i][j] = Math.max(dp[i][j], coins);
                }
            }
        }
        
        return dp[0][n + 1];
    }
}
