-- 1. Create Tables with Initial Constraints
CREATE TABLE USERS (
    UserID INT NOT NULL,
    UserName VARCHAR(100),
    Email VARCHAR(100) NOT NULL,
    RegistrationDate DATE,
    PRIMARY KEY (UserID)
);

CREATE TABLE ACTIVITIES (
    ActivityID INT NOT NULL,
    UserID INT,
    ActivityType VARCHAR(50),
    ActivityDate DATE,
    PRIMARY KEY (ActivityID)
);

CREATE TABLE VITALS (
    VitalID INT NOT NULL,
    UserID INT,
    HeartRate INT,
    BloodPressure VARCHAR(20), -- Corrected typo: 'BloddPressure' to 'BloodPressure'
    RecordedDate DATE,
    PRIMARY KEY (VitalID)
);

-- 2. Modify USERS Table: Change Primary Key to Email
-- Note: Email is already NOT NULL, which is required for a Primary Key.
ALTER TABLE USERS DROP PRIMARY KEY, ADD PRIMARY KEY (Email);

-- 3. Modify ACTIVITIES Table: Remove Primary Key
ALTER TABLE ACTIVITIES DROP PRIMARY KEY;
