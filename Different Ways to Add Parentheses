Given a string expression of numbers and operators, return all possible results from computing all the different possible ways to group numbers and operators. You may return the answer in any order.

The test cases are generated such that the output values fit in a 32-bit integer and the number of different results does not exceed 104.

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class Solution {
    // Memoization map to store results of sub-expressions
    private Map<String, List<Integer>> memo = new HashMap<>();

    public List<Integer> diffWaysToCompute(String expression) {
        // If we have already computed this sub-expression, return it
        if (memo.containsKey(expression)) {
            return memo.get(expression);
        }

        List<Integer> res = new ArrayList<>();

        // Loop through the expression to find operators
        for (int i = 0; i < expression.length(); i++) {
            char charAt = expression.charAt(i);

            if (charAt == '+' || charAt == '-' || charAt == '*') {
                // Divide: Split into left and right sub-expressions
                String leftPart = expression.substring(0, i);
                String rightPart = expression.substring(i + 1);

                List<Integer> leftResults = diffWaysToCompute(leftPart);
                List<Integer> rightResults = diffWaysToCompute(rightPart);

                // Conquer: Combine results from left and right using the operator
                for (int left : leftResults) {
                    for (int right : rightResults) {
                        if (charAt == '+') {
                            res.add(left + right);
                        } else if (charAt == '-') {
                            res.add(left - right);
                        } else if (charAt == '*') {
                            res.add(left * right);
                        }
                    }
                }
            }
        }

        // Base Case: If no operators were found, the expression is a single number
        if (res.isEmpty()) {
            res.add(Integer.parseInt(expression));
        }

        // Store in memoization map before returning
        memo.put(expression, res);
        return res;
    }
}
