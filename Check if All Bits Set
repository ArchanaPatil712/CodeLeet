Given a number n, check whether every bit in the binary representation of the given number is set or not. Return true if yes, otherwise false.
public class BitCheck {
    public static boolean areAllBitsSet(int n) {
        // 0 and negative numbers do not have all bits set
        if (n <= 0) {
            return false;
        }
        return (n & (n + 1)) == 0;
    }

    public static void main(String[] args) {
        System.out.println(areAllBitsSet(7));  // Output: true  (binary: 111)
        System.out.println(areAllBitsSet(6));  // Output: false (binary: 110)
    }
}
